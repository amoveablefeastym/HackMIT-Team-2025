# API Keys for HackMIT-Team-2025

# Required for transcript-to-notes (Claude/Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required for transcript-to-structured (Gemini via LangExtract)
LANGEXTRACT_API_KEY=your-gemini-api-key-here

# Optional: Change the model (default: gemini-2.0-flash)
# LANGEXTRACT_MODEL_ID=gemini-2.0-flash

# Required for OpenAI-based scripts
OPENAI_API_KEY=your-openai-api-key-here
